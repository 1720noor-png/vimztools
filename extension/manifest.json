{
  "manifest_version": 3,
  "name": "Vimz.ai — Smart Web Utilities & SEO Inspector",
  "version": "1.0.0",
  "description": "Inspect on-page SEO meta tags, format text and JSON, and access 1,000+ free online tools directly from your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Vimz.ai Web Utilities",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://charming-vitality-production-dd02.up.railway.app/*"
  ]
}
